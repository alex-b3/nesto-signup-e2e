# Copy to .env only if you need different values.
# Everything has a working default, so the suite runs without this file.

# The application under test.
BASE_URL=https://app.qa.nesto.ca

# Domain for generated test accounts.
# Must not be example.com/.org/.net or test.com: the API rejects those with
# 422 "placeholder email detected".
EMAIL_DOMAIN=qa-automation.test

# Set to true to fail a test when its page logs a console error or an uncaught
# script error. Otherwise the errors are only listed in the report.
FAIL_ON_PAGE_ERRORS=false
