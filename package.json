{
  "name": "nesto-signup-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "End-to-end tests for the nesto signup page (QA), in English and French.",
  "license": "UNLICENSED",
  "scripts": {
    "test": "playwright test",
    "test:en": "playwright test --project=chromium-en",
    "test:fr": "playwright test --project=chromium-fr",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.10",
    "typescript": "^7.0.2"
  }
}
