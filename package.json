{
  "name": "nesto-signup-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "End-to-end tests for the nesto signup page (QA), in English and French.",
  "license": "UNLICENSED",
  "scripts": {
    "test": "playwright test",
    "test:en": "playwright test --project=chromium-en",
    "test:fr": "playwright test --project=chromium-fr",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^20.19.43",
    "dotenv": "^18.0.10",
    "eslint": "^10.15.0",
    "eslint-plugin-playwright": "^2.12.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0"
  }
}
